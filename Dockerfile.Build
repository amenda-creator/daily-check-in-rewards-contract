# Stage 2: Create a clean Ubuntu-based image for copying built files
FROM ubuntu:latest

# Install necessary packages
RUN apt-get update && apt-get install -y nodejs npm

# Copy your project files into the container
WORKDIR /daily-check-in-rewards-contract

# Clear the contents of the working directory
RUN rm -rf ./*

# Copy package.json and package-lock.json
COPY package*.json /daily-check-in-rewards-contract/

# Install dependencies
RUN npm install

COPY src /daily-check-in-rewards-contract/src/

# Copy the HotPocket config override and environment file (MANDATORY)
COPY hp.cfg.override /daily-check-in-rewards-contract/
COPY .env /daily-check-in-rewards-contract/

# Build your project using the npm script instead of manual ncc build
RUN npm run buildLinux
